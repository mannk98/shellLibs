function nw-dhcp-discover() {
  [[ ${1} = "-h" || -z ${1} ]] && {
    echo "Usage: $FUNCNAME  <nw-iface>
Note: This script need sudo permission to execute."
    return 0
  }
  _run dhclient "${1}" -v
}

function nw-ubuntu-setStaticIp {
  [[ ${1} = "-h" || -z ${1} ]] && {
    echo "Usage: $FUNCNAME  <nw-iface> <ip/24> <gatewayIP>
Note: This script need sudo permission to execute."
    return 0
  }

  local nwIface=${1} IP=${2} gatewayIP=${3}
  _need_root || return 1
  _confirm "Add ${IP} to ${nwIface} and set default route via ${gatewayIP}?" || return 1
  _run ip addr add "${IP}" dev "${nwIface}"
  _run ip route add default via "${gatewayIP}"
}

function nw-check-server-udp-port() {
  [[ ${1} = "-h" || -z ${1} ]] && {
    echo "Usage: $FUNCNAME  <hostname/IP> <port>
Note: This script need sudo permission to execute."
    return 0
  }
  nc -v -u -z -w 3 "${1}" "${2}"
}

function nw-IptableAddLimitInboudPort {
  [[ ${1} = "-h" || -z ${1} ]] && {
    echo "Usage: $FUNCNAME  <port> <allowsubnet/IP> <tcp/udp>
Note: This script need sudo permission to execute."
    return 0
  }
  _need_root || return 1
  command -v netfilter-persistent >/dev/null 2>&1 || {
    log-info "netfilter-persistent is not installed, installing it"
    _run apt install netfilter-persistent
  }
  local port=$1 subnetIp=$2 protocol=$3

  _confirm "Add iptables rules: allow ${protocol}/${port} from ${subnetIp}, DROP it for everyone else?" || return 1
  _run iptables -A INPUT -p "${protocol}" -s "${subnetIp}" --dport "${port}" -j ACCEPT
  _run iptables -A INPUT -p "${protocol}" --dport "${port}" -j DROP
  _run netfilter-persistent save
}

function nw-IptableDelLimitInboudPort {
  [[ ${1} = "-h" || -z ${1} ]] && {
    echo "Usage: $FUNCNAME  <port> <allowsubnet/IP> <tcp/udp>
Note: This script need sudo permission to execute."
    return 0
  }
  _need_root || return 1
  command -v netfilter-persistent >/dev/null 2>&1 || {
    log-info "netfilter-persistent is not installed, installing it"
    _run apt install netfilter-persistent
  }
  local port=$1 subnetIp=$2 protocol=$3

  _confirm "Remove the iptables limit rules for ${protocol}/${port} from ${subnetIp}?" || return 1
  _run iptables -D INPUT -p "${protocol}" -s "${subnetIp}" --dport "${port}" -j ACCEPT
  _run iptables -D INPUT -p "${protocol}" --dport "${port}" -j DROP
  _run netfilter-persistent save
}

nwIaceGetIPmask() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <interface>
Get IP mask of network iface."
    return 0
  }
  local bitMask
  bitMask=$(ip addr show "$1" | awk '/inet / {print $2}' | cut -d '/' -f 2)

  local ones=$((0xFFFFFFFF << (32 - bitMask))) # Create mask with leftmost 'bitmask' number of bits set to 1
  # Extract each octet of the IP mask
  local oct1=$(((ones & 0xFF000000) >> 24))
  local oct2=$(((ones & 0x00FF0000) >> 16))
  local oct3=$(((ones & 0x0000FF00) >> 8))
  local oct4=$((ones & 0x000000FF))

  # Output the IP mask in dotted-decimal format
  echo "$oct1.$oct2.$oct3.$oct4"
}

nwSetupAccessPoint() {
  [[ $1 == "-h" || -z $1 || -z $2 ]] && {
    echo "Usage: sudo $FUNCNAME <ssid> <pass>
Note: This script need sudo permission to execute."
    return 0
  }
  local ssid="${1}" pass="${2}"

  _need_root || return 1
  _confirm "Build + install the 8821au driver and start an AP for SSID '${ssid}'?" || return 1

  local tmpDir
  tmpDir=$(mktemp -d)
  cd "${tmpDir}" || return 1
  _run apt update
  _run apt install -y "linux-headers-$(uname -r)" build-essential bc dkms git libelf-dev rfkill iw hostapd
  mkdir -p src && cd src || return 1
  _run git clone https://github.com/morrownr/8821au-20210708.git
  cd src/8821au-20210708 || return 1
  _run apt install gcc-12
  _run ./install-driver.sh

  mkdir -p ~/mannkAP && cd ~/mannkAP || return 1
  _run git clone https://github.com/mannk98/create_ap.git
  cd create_ap || return 1
  _run ./create_ap -m nat wlx909a4a82dc60 enp2s0 "${ssid}" "${pass}" --country VN --ieee80211ac -c 36 --hidden --freq-band 5 --no-virt
}
