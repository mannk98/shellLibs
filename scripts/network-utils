#!/bin/bash

command -v log-run   >/dev/null 2>&1 || source "$(command -v logshell    2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/logshell")"
command -v checkOsID >/dev/null 2>&1 || source "$(command -v checksystem 2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/checksystem")"
command -v _run      >/dev/null 2>&1 || source "$(command -v safetylib   2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/safetylib")"

# connect dhcp, with wpa_supplicant
nwWifiConnect2AP_networkingService() {
  [[ $1 == "-h" || -z $1 || -z $2 || -z $3 ]] && {
    echo "Usage: sudo $FUNCNAME <ssid> <pass> <device>"
    return 0
  }
  local ssid="${1}" pass="${2}" device="${3}"

  _need_root || return 1
  _confirm "Configure DHCP wifi on ${device} (edits /etc/network/interfaces + wpa_supplicant)?" || return 1

  [[ $(checkIfFileHaveText "${device}" /etc/network/interfaces) == "no" ]] && {
    log-info "write config to /etc/network/interfaces"
    _append_line /etc/network/interfaces "allow-hotplug ${device}"
    _append_line /etc/network/interfaces "iface ${device} inet dhcp"
    _append_line /etc/network/interfaces "wpa-conf /etc/wpa_supplicant/${device}.conf"
  } || log-error "Error when write config to /etc/network/interfaces"

  [[ ! -f /etc/wpa_supplicant/"${device}".conf ]] && {
    log-info "write config to /etc/wpa_supplicant/${device}.conf"
    _write_file /etc/wpa_supplicant/"${device}".conf <<EOF
update_config=1
country=VN
EOF
    # wpa_passphrase emits a multi-line block to append; guard the >> by hand so
    # dry-run previews it (it can't go through _append_line, which is one line).
    if [[ -n ${SHELLLIBS_DRYRUN:-} ]]; then
      log-run "DRY-RUN would append wpa_passphrase output to /etc/wpa_supplicant/${device}.conf"
    else
      wpa_passphrase "${ssid}" "${pass}" >>/etc/wpa_supplicant/"${device}".conf
    fi
  }

  log-info "Restart networking service..."
  _run systemctl restart networking
  # bgscan=\"simple:60:-70:7200\"
  # ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
}

nwWifiConnect2AP_withoutwpaconf() {
  [[ $1 == "-h" || -z $1 || -z $2 || -z $3 ]] && {
    echo "Usage: sudo $FUNCNAME <ssid> <pass> <device>
Only write config to /etc/network/interfaces"
    return 0
  }
  local ssid="${1}" pass="${2}" device="${3}"

  _need_root || return 1
  _confirm "Write wifi config for ${device} to /etc/network/interfaces?" || return 1

  [[ $(checkIfFileHaveText "${device}" /etc/network/interfaces) == "no" ]] && {
    log-info "write config to /etc/network/interfaces"
    _append_line /etc/network/interfaces "allow-hotplug ${device}"
    _append_line /etc/network/interfaces "iface ${device} inet dhcp"
    _append_line /etc/network/interfaces "        wpa-ssid \"${ssid}\""
    _append_line /etc/network/interfaces "        wpa-psk \"${pass}\""
  } || log-error "Error when write config to /etc/network/interfaces"

  log-info "Restart networking service..."
  _run systemctl restart networking
}

# start isc-dhcp-server on specific interface
# need set staticip for this interface before
nwEnableDhcp_v4Service() {
  ### /etc/default/isc-dhcp-server

  # Defaults for isc-dhcp-server (sourced by /etc/init.d/isc-dhcp-server)

  # Path to dhcpd's config file (default: /etc/dhcp/dhcpd.conf).
  #DHCPDv4_CONF=/etc/dhcp/dhcpd.conf
  #DHCPDv6_CONF=/etc/dhcp/dhcpd6.conf

  # Path to dhcpd's PID file (default: /var/run/dhcpd.pid).
  #DHCPDv4_PID=/var/run/dhcpd.pid
  #DHCPDv6_PID=/var/run/dhcpd6.pid

  # Additional options to start dhcpd with.
  #       Don't use options -cf or -pf here; use DHCPD_CONF/ DHCPD_PID instead
  #OPTIONS=""

  # On what interfaces should the DHCP server (dhcpd) serve DHCP requests?
  #       Separate multiple interfaces with spaces, e.g. "eth0 eth1".
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <net_interface>
Note: This function setup dhcp server on specific network interface"
    return 0
  }

  _need_root || return 1
  _confirm "Set up an isc-dhcp-server on $1 (overwrites /etc/dhcp/dhcpd.conf)?" || return 1

  [[ $(checkIfCommandExist "dhcpd") == "no" ]] && {
    _run apt install isc-dhcp-server
  }

  log-info "Write config to /etc/dhcp/dhcpd.conf && /etc/default/isc-dhcp-server"
  local interface="${1}"
  _write_file /etc/dhcp/dhcpd.conf <<EOF
option domain-name-servers 1.1.1.1;
default-lease-time 600;
ddns-update-style none; ddns-updates off;
subnet 192.168.0.0 netmask 255.255.255.0 {
       max-lease-time 7200;
       range 192.168.0.200 192.168.0.229;
       option subnet-mask 255.255.255.0;
       option broadcast-address 192.168.0.255;
       option routers 192.168.0.1;
       }
EOF

  _write_file /etc/default/isc-dhcp-server <<EOF
INTERFACESv4="${interface}"
INTERFACESv6=""
EOF

  if ! _run systemctl restart isc-dhcp-server; then
    log-error "Error when starting DHCP server"
  else
    log-step "Start DHCP server successfully. Gateway: 192.168.0.1, IP range:192.168.0.200 192.168.0.229;"
  fi
}

######################################
#    nmcli Command (NetworkManager)  #
######################################

nmcliWifiCardOff() {
  _run nmcli radio wifi off
}

nmcliWifiCardOn() {
  _run nmcli radio wifi on
}

nmcliWifiScan() {
  nmcli dev wifi rescan && nmcli dev wifi list
}

nmcliWifiConnect2AP() {
  [[ $1 == "-h" || -z $1 || -z $2 || -z $3 ]] && {
    echo "Usage: sudo $FUNCNAME <ssid> <pass> <interface>
Only write config to /etc/network/interfaces"
    return 0
  }
  local ssid="${1}"
  local pass="${2}"
  local interface="${3}"

  if _run nmcli dev wifi con "${ssid}" password "${pass}" ifname "${interface}"; then
    log-step "Success connect to ${ssid} using ${interface}"
  fi
}

nmcliDisableCon() {
  local con="${1}"
  _run nmcli connection down "${con}"
}

nmcliEnableCon() {
  local con="${1}"
  _run nmcli connection up "${con}"
}

nmcliShowAllCons() {
  nmcli con show
}

nmcliShowConDetail() {
  local con="${1}"
  nmcli con show "${con}"
}

nmcliShowDevsInfo() {
  nmcli
}

# set static ip for specific interface
nmcliSetStaticIP() {
  [[ $1 == "-h" || -z $1 || -z $2 || -z $3 ]] && {
    echo "Usage: sudo $FUNCNAME <interface> <gateway> <address>
Set static IP for interface."
    return 0
  }
  local interface="${1}" gateway="${2}" address="${3}"

  _confirm "Set static IP ${address} (gw ${gateway}) on ${interface}? This may drop your current connection." || return 1
  _run nmcli con mod "${interface}" ipv4.method manual
  _run nmcli con mod "${interface}" ipv4.gateway "${gateway}"
  _run nmcli con mod "${interface}" ipv4.address "${address}"
  _run nmcli con down "${interface}"
  _run nmcli con up "${interface}"
}

nmcliRestartIface() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <interface>
Restart network interface."
    return 0
  }
  local interface="${1}"

  _run ip link set "${interface}" down
  _run ip link set "${interface}" up
}

nwIfaceGetIP() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <interface>
Get IP of iface network."
    return 0
  }
  ip addr show "$1" | awk '/inet / {print $2}' | cut -d '/' -f 1
}

# rename
nwIfaceRename() {
  [[ $1 == "-h" || -z $1 || -z $2 ]] && {
    echo "Usage: sudo $FUNCNAME <interface-Name> <new-name>"
    return 0
  }
  local interface="${1}" newiname="${2}"

  _confirm "Rename interface ${interface} -> ${newiname}?" || return 1
  _run ip link set dev "${interface}" down
  _run ip link set dev "${interface}" name "${newiname}"
  _run ip link set dev "${interface}" up
}

nwIfaceRestart() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <net_interface>"
    return 0
  }
  _run ifdown "${1}"
  _run ifup "${1}"
}

function nwIPv6Disable() {
  [[ $1 == "-h" ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME
Temporarily disable IPv6 via sysctl."
    return 0
  }
  _need_root || return 1
  _run sysctl -w net.ipv6.conf.all.disable_ipv6=1
  _run sysctl -w net.ipv6.conf.default.disable_ipv6=1
  _run sysctl -w net.ipv6.conf.lo.disable_ipv6=1
  echo "Temporary disable IPv6"
}

function nwIfaceSetPromisc() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <iface_name>"
    return 0
  }
  _need_root || return 1
  _run ip link set "${1}" promisc on
}

function nwSetupCentos7() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <iface_name> <ip> <netmark> <gateway> <iface_uuid>"
    return 0
  }
  local iface_name=$1 ip=$2 netmark=$3 gateway=$4 iface_uuid=$5

  _need_root || return 1
  _confirm "Write CentOS7 static network config for ${iface_name} (overwrites /etc/resolv.conf)?" || return 1

  _write_file /etc/sysconfig/network-scripts/ifcfg-"${iface_name}" <<EOF
TYPE="Ethernet"
BOOTPROTO="static"
IPADDR=${ip}
NETMASK=${netmark}
NM_CONTROLLED=no
DEFROUTE="yes"
PEERDNS="yes"
PEERROUTES="yes"
IPV4_FAILURE_FATAL="no"
IPV6INIT="yes"
IPV6_AUTOCONF="yes"
IPV6_DEFROUTE="yes"
IPV6_PEERDNS="yes"
IPV6_PEERROUTES="yes"
IPV6_FAILURE_FATAL="no"
NAME="${iface_name}"
UUID="${iface_uuid}"
DEVICE="${iface_name}"
ONBOOT="yes"
EOF

  _write_file /etc/sysconfig/network <<EOF
NETWORKING=yes
HOSTNAME=centos7
GATEWAY=${gateway}
EOF

  _write_file /etc/resolv.conf <<EOF
nameserver 8.8.8.8
nameserver 8.8.4.4
EOF
}

function nwIfaceFlush() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <iface_name>"
    return 0
  }
  _confirm "Flush all IP addresses on ${1}?" || return 1
  _run ip addr flush dev "${1}"
}

function nwBridgeDelete() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <iface_name>"
    return 0
  }
  _confirm "Bring down and delete bridge ${1}?" || return 1
  _run ip link set "${1}" down
  _run brctl delbr "${1}"
}

function nwBridgeListAll() {
  ip link show type bridge
}

nwBridgeListPortsOfBridge() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <bridge_name>"
    return 0
  }
  if ! command -v bridge &>/dev/null; then
    echo "install bridge-utils first."
    return 1
  fi
  ip link show master "${1}"
}

nw-bandwidth-limit() {
  [[ ${1} = "-h" || -z ${1} ]] && {
    echo "Usage:
$FUNCNAME  <download_limit> <upload_limit>
  example: bandwidth-limit 256 128 --> kbps

bandwidth-limit clear --> clear

Note: This script need sudo permission to execute."
    return 0
  }
  log-info "Install wondershaper"
  _run apt install wondershaper
  local upload_limit=${2} download_limit=${1}

  [[ ${download_limit} == "clear" ]] && {
    _run wondershaper clear "${upload_limit}"
  } || {
    _run wondershaper eth1 "${download_limit}" "${upload_limit}"
  }
}

function nw-tcpdump-outbound-port() {
