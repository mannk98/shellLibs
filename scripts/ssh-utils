#!/bin/bash

command -v _run >/dev/null 2>&1 || source "$(command -v safetylib 2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/safetylib")"

# Text formatting and colors
BOLD="\033[1m"
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
NC="\033[0m" # No Color

function ssh_show_usage() {
  echo -e "${BOLD}SSH Utilities${NC}\n"
  echo -e "${BOLD}Port Forwarding:${NC}"
  echo -e "  ${GREEN}ssh-forward-local${NC}    - Forward local port to remote server"
  echo -e "  ${GREEN}ssh-forward-remote${NC}   - Forward remote port to local machine"
  echo -e "  ${GREEN}ssh-tunnel${NC}           - Create a SOCKS proxy through SSH"
  echo -e "\n${BOLD}Server Management:${NC}"
  echo -e "  ${GREEN}ssh-enable-root${NC}      - Enable/disable root login via SSH"
  echo -e "  ${GREEN}ssh-copy-key${NC}         - Copy SSH key to remote host"
  echo -e "  ${GREEN}ssh-test-connection${NC}   - Test SSH connection to a host"
  echo -e "\nUse 'command -h' for more info on a specific command"
}

function _check_ssh_installed() {
  if ! command -v ssh &> /dev/null; then
    echo -e "${RED}Error: SSH is not installed${NC}" >&2
    return 1
  fi
  return 0
}

function _validate_ssh_connection() {
  local host="$1"
  if ! ssh -q -o BatchMode=yes -o ConnectTimeout=5 "$host" exit; then
    echo -e "${RED}Error: Cannot connect to ${host}${NC}" >&2
    return 1
  fi
  return 0
}

function ssh-forward-local() {
  [[ "$1" == "-h" || -z "$1" ]] && {
    echo -e "${BOLD}Usage:${NC} ${FUNCNAME[0]} <local_port:remote_host:remote_port> <user@host> [ssh_options]"
    echo -e "\n${BOLD}Example:${NC} ${FUNCNAME[0]} 9000:localhost:5432 user@example.com -Nf"
    echo -e "  Forwards local port 9000 to example.com's port 5432 via SSH"
    return 0
  }

  _check_ssh_installed || return 1
  
  local port_mapping="$1"
  shift
  local target="$1"
  shift
  
  if [[ -z "$port_mapping" || -z "$target" ]]; then
    echo -e "${RED}Error: Missing required arguments${NC}" >&2
    return 1
  fi
  
  echo -e "${GREEN}Forwarding ${port_mapping} to ${target}...${NC}"
  ssh -L "$port_mapping" "$target" "$@"
}

function ssh-forward-remote() {
  [[ "$1" == "-h" || -z "$1" ]] && {
    echo -e "${BOLD}Usage:${NC} ${FUNCNAME[0]} <remote_port:local_host:local_port> <user@host> [ssh_options]"
    echo -e "\n${BOLD}Example:${NC} ${FUNCNAME[0]} 8080:localhost:80 user@example.com -Nf"
    echo -e "  Forwards remote port 8080 to local port 80 via SSH"
    return 0
  }
  
  _check_ssh_installed || return 1
  
  local port_mapping="$1"
  shift
  local target="$1"
  shift
  
  if [[ -z "$port_mapping" || -z "$target" ]]; then
    echo -e "${RED}Error: Missing required arguments${NC}" >&2
    return 1
  fi
  
  echo -e "${GREEN}Forwarding remote ${port_mapping}...${NC}"
  ssh -R "$port_mapping" "$target" "$@"
}

function ssh-tunnel() {
  [[ "$1" == "-h" || -z "$1" ]] && {
    echo -e "${BOLD}Usage:${NC} ${FUNCNAME[0]} <local_port> <user@host> [ssh_options]"
    echo -e "\n${BOLD}Example:${NC} ${FUNCNAME[0]} 1080 user@example.com -Nf"
    echo -e "  Creates a SOCKS proxy on localhost:1080"
    return 0
  }
  
  _check_ssh_installed || return 1
  
  local port="$1"
  shift
  local target="$1"
  shift
  
  if [[ -z "$port" || -z "$target" ]]; then
    echo -e "${RED}Error: Missing required arguments${NC}" >&2
    return 1
  fi
  
  echo -e "${GREEN}Creating SOCKS proxy on port ${port}...${NC}"
  echo -e "${YELLOW}Configure your browser to use SOCKS5 proxy at 127.0.0.1:${port}${NC}"
  ssh -D "$port" -C -N -f "$target" "$@"
}

function ssh-copy-key() {
  [[ "$1" == "-h" || -z "$1" ]] && {
    echo -e "${BOLD}Usage:${NC} ${FUNCNAME[0]} <user@host> [ssh_options]"
    echo -e "\nCopies your public key to the remote host for passwordless login"
    return 0
  }
  
  _check_ssh_installed || return 1
  
  local target="$1"
  shift
  
  if [[ -z "$target" ]]; then
    echo -e "${RED}Error: Missing target host${NC}" >&2
    return 1
  fi
  
  echo -e "${GREEN}Copying SSH key to ${target}...${NC}"
  ssh-copy-id "$target" "$@" || {
    echo -e "${YELLOW}ssh-copy-id failed, trying manual method...${NC}"
    cat ~/.ssh/id_rsa.pub | ssh "$target" "mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"
  }
}

function ssh-enable-root() {
  # Require an explicit action — a bare call used to default to "enable", silently
  # turning ON root SSH login on a help/typo. Now it prints usage instead.
  [[ "$1" == "-h" || -z "$1" ]] && {
    echo -e "${BOLD}Usage:${NC} sudo ${FUNCNAME[0]} <enable|disable>"
    echo -e "\nEnables or disables root login via SSH (edits sshd_config + restarts SSH)"
    return 0
  }

  _need_root || return 1

  local action="$1"
  # Path is overridable for testing; defaults to the real sshd_config.
  local config_file="${SHELLLIBS_SSHD_CONFIG:-/etc/ssh/sshd_config}"
  local value
  case "$action" in
    enable) value="yes" ;;
    disable) value="no" ;;
    *)
      echo -e "${RED}Error: Invalid action. Use 'enable' or 'disable'${NC}" >&2
      return 1
      ;;
  esac

  if [[ ! -f "$config_file" ]]; then
    echo -e "${RED}Error: SSH config file not found at ${config_file}${NC}" >&2
    return 1
  fi

  # Route the destructive edit through safetylib: previewable (SHELLLIBS_DRYRUN),
  # backed up first, and confirmed before mutating a security-sensitive file.
  _confirm "Set 'PermitRootLogin ${value}' in ${config_file} and restart SSH?" || return 1
  _backup_file "$config_file"
  _run sed -i "s/^#*PermitRootLogin.*/PermitRootLogin ${value}/" "$config_file"
  echo -e "${GREEN}Set PermitRootLogin ${value} in ${config_file}${NC}"

  # Restart SSH service if available
  if command -v systemctl &>/dev/null; then
    _run systemctl restart sshd
  elif command -v service &>/dev/null; then
    _run service ssh restart
  else
    echo -e "${YELLOW}Please restart the SSH service for changes to take effect${NC}"
  fi
}

function ssh-test-connection() {
  [[ "$1" == "-h" || -z "$1" ]] && {
    echo -e "${BOLD}Usage:${NC} ${FUNCNAME[0]} <user@host> [port]"
    echo -e "\nTests SSH connection to a host"
    return 0
  }
  
  _check_ssh_installed || return 1
  
  local target="$1"
  local port="${2:-22}"
  
  echo -e "${GREEN}Testing SSH connection to ${target} on port ${port}...${NC}"
  
  if ssh -p "$port" -o BatchMode=yes -o ConnectTimeout=5 "$target" exit &>/dev/null; then
    echo -e "${GREEN}✓ Connection successful!${NC}"
    return 0
  else
    echo -e "${RED}✗ Connection failed!${NC}" >&2
    return 1
  fi
}