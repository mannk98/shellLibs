#!/bin/bash

command -v log-run >/dev/null 2>&1 || source "$(command -v logshell  2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/logshell")"
command -v _run    >/dev/null 2>&1 || source "$(command -v safetylib 2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/safetylib")"

function disk-create-one-partition() {
  [[ $1 == "-h" || -z $1 || -z $2 ]] && {
    echo "Usage: sudo $FUNCNAME <disk> <filesystem-format>"
    echo "Example: sudo $FUNCNAME /dev/sda ext4"
    return 0
  }

  diskname=$1
  format=$2

  # Check if the disk exists
  if [[ ! -b $diskname ]]; then
    echo "Error: Disk $diskname not found."
    return 1
  fi

  echo "Creating a new partition on $diskname..."

  # Create a new partition table (GPT)
  parted "$diskname" mklabel gpt

  # Create a primary partition on the entire disk
  parted -a optimal -- "$diskname" mkpart primary "$format" 1MiB 100%

  # Wait a moment to ensure the partition is recognized
  sleep 2
  partition="${diskname}1"

  echo "Formatting $partition with $format filesystem..."
  mkfs."$format" "$partition"

  echo "Partition $partition created and formatted as $format."
}

function disk-mount-partition() {
  [[ $1 == "-h" || -z $1 || -z $2 || -z $3 ]] && {
    echo "Usage: sudo $FUNCNAME <partition> <mount-point> <filesystem-format>"
    echo "Example: sudo $FUNCNAME /dev/sda1 /mnt/docker/data ext4"
    return 0
  }

  partition=$1
  mount_point=$2
  format=$3

  if [[ ! -b $partition ]]; then
    echo "Error: Partition $partition not found."
    return 1
  fi

  _need_root || return 1
  _confirm "Mount ${partition} at ${mount_point} and add a UUID entry to /etc/fstab?" || return 1

  if [[ ! -d $mount_point ]]; then
    echo "Creating mount point at $mount_point..."
    mkdir -p "$mount_point"
  fi

  # Mount the partition
  echo "Mounting $partition to $mount_point..."
  if ! _run mount "$partition" "$mount_point"; then
    echo "Error: Failed to mount $partition to $mount_point."
    return 1
  fi

  disk_uuid=$(blkid -s UUID -o value "$partition")
  if [[ -z $disk_uuid ]]; then
    echo "Error: Failed to retrieve UUID for $partition."
    return 1
  fi
  echo "Adding $partition to /etc/fstab..."
  fstab_entry="UUID=$disk_uuid $mount_point $format defaults 0 2"
  _append_line /etc/fstab "$fstab_entry"

  echo "Partition $partition successfully mounted at $mount_point and added to /etc/fstab."
}

function disk-check-performance() {
  [[ ${1} == "-h" ]] && {
    echo "Use: $FUNCNAME   (read + write perf test on /dev/vda; needs hdparm)"
    return 0
  }

  if ! command -v hdparm >/dev/null 2>&1; then
    echo "Install hdparm command first"
    return 1
  fi

  hdparm -Tt /dev/vda && dd if=/dev/zero of=/tmp/output bs=1M count=2048 conv=fdatasync
  rm -f /tmp/output
}
