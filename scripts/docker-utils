#!/bin/bash

command -v log-run   >/dev/null 2>&1 || source "$(command -v logshell    2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/logshell")"
command -v checkOsID >/dev/null 2>&1 || source "$(command -v checksystem 2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/checksystem")"
command -v _run      >/dev/null 2>&1 || source "$(command -v safetylib   2>/dev/null || echo "$(dirname "${BASH_SOURCE[0]}")/safetylib")"

#check if container is running or not
#arg: path to container name
function docker-container-is-running() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Missing container name to check parameter
		Use: ${FUNCNAME[0]} <container-name>"
    return 1
  }
  #grep -qie: quiet (don't redirect to stdout/err), ignore uppercase(R)
  #docker container inspect return Json format --> grep --> if have word running --> return 0 (true)
  docker container inspect -f '{{.State}}' "${1}" 2>/dev/null | grep -qie 'Running' && return 0 || return 1
}

#check if docker image is exist or not
#arg: path to docker image
function docker-image-is-exist() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Missing container name to check parameter
		Use: ${FUNCNAME[0]} <docker-image>"
    return 1
  }
  docker image inspect -f '{{.RepoTags}} {{.Created}}' "${1}" &>/dev/null
}

#check if docker container is exist or not
#arg: path to docker container
function docker-container-is-exist() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Missing container name to check parameter
		Use: ${FUNCNAME[0]} <container-name>"
    return 1
  }
  docker container inspect -f '{{.State}}' "$1" &>/dev/null
}

#create docker network
#args: [ip] [subnet]
#return 0 if success, 1 if false
function docker-network-create() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Use: ${FUNCNAME[0]} <network-name> <sub-net>"
    return 1
  }
  local MYNETWORK=$1
  local MYNETWORK_SUBNET=$2
  : "${MYNETWORK:=mynetwork}"
  : "${MYNETWORK_SUBNET:=172.172.0.0/16}"

  _run docker network create -o "com.docker.network.bridge.name"="${MYNETWORK}" --subnet="${MYNETWORK_SUBNET}" "${MYNETWORK}"
}
# docker network create -o "com.docker.network.bridge.name"="MYNETWORK" --subnet="172.172.0.0/24" MYNETWORK

function docker-network-create-overlay() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Use: ${FUNCNAME[0]} <name> <subnet>"
    return 1
  }
  local name=$1
  local subnet=$2
  _run docker network create --scope=swarm --driver overlay --attachable --subnet="${subnet}" "${name}"
}

function docker-network-create-bridge-scopeSwarm() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Use: ${FUNCNAME[0]} <name> <subnet>"
    return 1
  }
  local name=$1
  local subnet=$2
  _run docker network create --scope=swarm --driver bridge --attachable --subnet="${subnet}" "${name}"
}

#args: [subnet]
#return subnet of MYNETWORK
function docker-network-get-cidr() {
  [[ ! $1 || $1 == "-h" ]] && return 1
  echo -n "$(docker inspect -f '{{range $k, $v := .IPAM.Config}}{{printf $v.Subnet}}{{end}}' "${1}")"
}

#check if container have network configuration
#arg:
function docker-network-is-exist() {
  [[ $1 ]] || return 1
  # docker network inspect -f: return info about one or more network (json), -f: using Go template
  docker network inspect -f '{{.Name}}' "${1}" &>/dev/null && return 0 || return 1
}

docker-find-container-from-hostpid() {
  { [[ $1 ]] && [[ -d /proc/$1 ]]; } || {
    echo "Missing host pid - write by thanhson.rf@gmail.com"
    return 1
  }
  local hostpid=${1}
  local dnamespace
  dnamespace=$(grep -e docker "/proc/${hostpid}/cgroup" | head -n 1 | grep -ioEe '[^/]+$')

  [[ $dnamespace ]] || {
    echo "Missing host pid - write by thanhson.rf@gmail.com"
    return 1
  }

  echo -e "Waitting ....."

  for container in $(docker ps -q --format "{{.Names}}"); do
    cnamespace=$(docker exec "$container" bash -c 'cat  /proc/1/cgroup')
    #  echo -e "\n\n___________dnamespace --> $dnamespace================\n\n"
    #  dnamespace=$(echo "${dnamespace}" | head -n 1 | grep -ioEe '[^/]+$')

    #  echo "Checking on ${container}:  $cnamespace - $dnamespace"
    echo "$cnamespace" | grep "$dnamespace" &>/dev/null && {
      echo "PID: $hostpid found in $container"
      return 0
    }
  done
  echo "Cannot found"
}

# use to kill when container is blocked.
docker-find-hostpid-from-containerName() {
  local containername=${1}
  ps auxw | grep "$(docker container ls | grep "${containername}" | awk '{print $1}')" | awk '{print $2}'
  #kill -9 12345678
}

docker-kill-container-by-hostpid() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: sudo ${FUNCNAME[0]} <container-name>
		kill -9 the host process backing a blocked container."
    return 0
  }
  local containername=${1} id
  id=$(ps auxw | grep "$(docker container ls | grep "${containername}" | awk '{print $1}')" | awk '{print $2}')
  [[ -z ${id} ]] && { log-error "no host pid found for container ${containername}"; return 1; }
  _confirm "kill -9 host pid ${id} (container ${containername})?" || return 1
  _run kill -9 "${id}"
}

docker-change-rootdir() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo ${FUNCNAME[0]} <new-docker-root-dir>
		Stops Docker, copies its data-root to the new path, rewrites
		/etc/docker/daemon.json, and restarts Docker. Needs root."
    return 0
  }

  _need_root || return 1
  _need_cmd docker || return 1
  local newpath=${1} oldpath
  oldpath=$(docker info -f '{{ .DockerRootDir}}')
  _confirm "Stop Docker, copy root ${oldpath} -> ${newpath}, and rewrite /etc/docker/daemon.json?" || return 1

  log-info "Stopping docker service."
  _run systemctl stop docker docker.socket containerd

  log-info "Copy old root $oldpath to $newpath ..."
  # if folder exist, do nothing
  [[ -d ${newpath} ]] && {
    log-warning "${newpath} is already existed, use exist, not copy data from old root"
  } || {
    _run mkdir -p "${newpath}"
    _run cp -rf "${oldpath}" "${newpath}"
  }

  log-info "Create new config at /etc/docker/daemon.json"
  local config
  [[ $(checkIfCommandExist nvidia-docker) == "yes" ]] && {
    config="
		{
            \"runtimes\": {
                \"nvidia\": {
                    \"path\": \"nvidia-container-runtime\",
                    \"runtimeArgs\": []
                }
            },
           \"data-root\": \"${newpath}\"
        }"
  } || {
    config="
        {
          \"data-root\": \"${newpath}\"
        }"
  }

  _write_file /etc/docker/daemon.json <<<"${config}"
  _run systemctl restart docker
  log-info "Apply new config, restarting docker service, new root dir is: "
  docker info -f '{{ .DockerRootDir}}'
}

docker-updateRestartRules() {
  [[ -n $(docker ps -q) ]] && {
    # shellcheck disable=SC2046  # intentional: multi-container-ID word splitting
    _run docker update --restart=always $(docker ps -q)
  }

  [[ -n $(docker ps --filter status=exited -q) ]] && {
    # shellcheck disable=SC2046  # intentional: multi-container-ID word splitting
    _run docker update --restart=no $(docker ps --filter status=exited -q)
  }
  echo "Have a good day <3"
}

docker-mapOverlay2-withImage() {
  # shellcheck disable=SC2046  # intentional: multi-container-ID word splitting
  docker inspect $(docker ps -qa) | jq -r 'map([.Name, .GraphDriver.Data.MergedDir]) | .[] | @tsv' | while IFS=$'\t' read -r name dir; do size=$(du -sh "$dir" | awk '{print $1}'); echo -e "$name\t$dir\t$size"; done
}

docker-updateLimitResource() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: sudo ${FUNCNAME[0]} <conname> <cpus> <ram> <ram+swap>
		example: ${FUNCNAME[0]} nginx 4 500M 1GB"
    return 0
  }

  local conname=${1}
  local cpus=${2}
  local ram=${3}
  local ramAndSwap=${4}

  if _run docker update --cpus "${cpus}" -m "${ram}" --memory-swap "${ramAndSwap}" "${conname}"; then
    echo "Success update container metrics resource. Have a good day!"
  fi
}

######################## GET INFO
docker-getIPInfo() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <container_name>"
    return 0
  }
  local conname=${1}
  docker inspect --format="{{range .NetworkSettings.Networks}}{{.IPAddress}}; {{end}}" "${conname}"
}

docker-getBindInfo() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <container_name>"
    return 0
  }
  local conname=${1}
  echo "Type, Source, Des, Mode, RW, Propagation"
  #docker inspect --format="{{range .Mounts}}{{.}}; {{end}}" "${conname}"
  docker inspect --format="{{range .Mounts}} Type:{{.Type}} RW:{{.RW}} {{.Source}}:{{.Destination}}; {{end}}" "${conname}"
}

function docker-getIPAll() {
  # shellcheck disable=SC2046  # intentional: multi-container-ID word splitting
  docker inspect -f '{{.Name}} - {{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' $(docker ps -q)
}

docker-execBash() {
  docker exec -it "${1}" bash
}

######################## BACKUP VOLUME
function docker-backup-volume() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <container_name_have_volume_need_to_backup> <path-of-volume-mount-inside-container>"
    return 0
  }
  local containername=${1}
  local volumeMountInside=${2}

  _run docker run --rm --volumes-from "${containername}" -v "$(pwd)":/backup debian:12.5 tar cvf /backup/"${containername}".bak.tar -C "${volumeMountInside}" .
}

function docker-restore-volume() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <restore_voulme> <backup_data_path_file_tar>
		(auto create restore_voulme_name if it's not existed )"
    return 0
  }
  local restoreVolumeName=${1}
  local backup_data_path_file_tar=${2}
  local filename
  filename=$(basename "$backup_data_path_file_tar")

  _confirm "Restore into volume ${restoreVolumeName} from ${backup_data_path_file_tar} (overwrites its contents)?" || return 1
  _run docker volume create "${restoreVolumeName}"
  _run docker run --rm -v "${restoreVolumeName}":/volume_data -v "${backup_data_path_file_tar}":/backup/"$filename" debian:12.5 bash -c "cd /volume_data && tar xvf /backup/""$filename"" --strip 1"
}

function docker-save-image() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <uuid_image/image_name:tag> [name_of_file.tar.gz]"
    return 0
  }
  local outfile="${2:-myimage_latest.tar.gz}"
  # `docker save | gzip > file` is a pipeline (not argv), so it can't go through
  # _run; guard the file write by hand so dry-run still previews it.
  if [[ -n ${SHELLLIBS_DRYRUN:-} ]]; then
    log-run "DRY-RUN would run: docker save ${1} | gzip > ${outfile}"
    return 0
  fi
  docker save "${1}" | gzip >"${outfile}"
}

# not commit what you mount
function docker-commit() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <uuid_image/image_name:tag> <new_image_name:tag> [change_entry_point]"
    return 0
  }
  local change=""
  [[ -n ${3} ]] && {
    change="--change='ENTRYPOINT ${3}'"
  }
  _run docker commit "${1}" "${2}" "${change}"
}

function docker-daemon-restart() {
  [[ $1 == "-h" ]] && {
    echo "Usage: sudo ${FUNCNAME[0]}
		systemctl daemon-reload + restart docker. Needs root."
    return 0
  }
  _need_root || return 1
  _run systemctl daemon-reload
  _run systemctl restart docker
}

function docker-network-create-macvlan() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Use: ${FUNCNAME[0]} <parent> <network-name> <host_sub-net> <host_gate-way> <dockerdhcp_ip_range> <macvlan_mode>
        Example: docker-network-create-macvlan enp1s0 macvlan.enp1s0 10.6.200.0/22 10.6.200.1 10.6.203.236/30 passthru"
    return 1
  }

  local parent=$1
  local network=$2
  local subnet=$3
  local host_gateway=$4
  local dockerdhcp_ip_range=$5
  local macvlan_mode=$6

  # Build argv (no eval): only append the optional flags when they were given.
  local -a cmd=(docker network create -d macvlan -o "parent=${parent}" --subnet="${subnet}" --gateway "${host_gateway}")
  [[ -n ${dockerdhcp_ip_range} ]] && cmd+=(--ip-range "${dockerdhcp_ip_range}")
  [[ -n ${macvlan_mode} ]] && cmd+=(-o "macvlan_mode=${macvlan_mode}")
  cmd+=("${network}")

  _run "${cmd[@]}"
}

function docker-commit-and-save() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <container-name/id> [tag] [/path/to/save]"
    return 0
  }
  local containername=$1
  local tag=$2
  local savedpath=$3

  [[ -z ${savedpath} ]] && {
    savedpath="./"
  }

  [[ -z ${tag} ]] && {
    tag="cloudstackcommit"
  }

  echo "Info: Commit container to image  ${containername}:${tag}"
  _run docker commit "${containername}" "${containername}:${tag}"
  echo "Info: Save image to ""${savedpath}""/""${containername}"".tar "
  _run docker save -o "${savedpath}"/"${containername}".tar "${containername}:${tag}"
  _run docker image rm "${containername}":"${tag}"
}

function docker-swarm-init() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <MANAGER-IP>"
    return 0
  }
  local MANAGER_IP=${1}
  _run docker swarm init --advertise-addr "${MANAGER_IP}"
}

function docker-swarm-listNode() {
  docker node ls
}

function docker-swarm-join() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <MANAGER-IP> <token>"
    return 0
  }
  local MANAGER_IP=${1}
  local token=${2}
  _run docker swarm join --token "${token}" "${MANAGER_IP}":2377
}

function docker-swarm-listService() {
  docker service ls
}

function docker-swarm-inspectService() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <service_name>"
    return 0
  }
  local service_name=${1}
  docker service inspect --pretty "${service_name}"
}

function docker-swarm-scaleService() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <service_name> <scale_number>"
    return 0
  }
  local service_name=${1}
  local scale_number=${2}
  _run docker service scale "${service_name}"="${scale_number}"
}

function docker-swarm-removeService() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <service_name>"
    return 0
  }
  local service_name=${1}
  _confirm "Remove swarm service ${service_name}?" || return 1
  _run docker service rm "${service_name}"
}
