#!/bin/bash
# Shell logging utility with color support
# Author: thanhson.rf@gmail.com

# Color codes
COLOR_RESET='\033[0m'
COLOR_WHITE='\033[0;37m'
COLOR_PURPLE='\033[0;35m'
COLOR_RED='\033[0;31m'
COLOR_BLUE='\033[0;34m'
COLOR_YELLOW='\033[0;33m'
COLOR_GREEN_U='\033[4;32m'

# Log levels
LOG_LEVEL_DEBUG=0
LOG_LEVEL_INFO=1
LOG_LEVEL_WARNING=2
LOG_LEVEL_ERROR=3
LOG_LEVEL_RUN=4
LOG_LEVEL_STEP=5

# Default log level (can be overridden)
: "${LOG_LEVEL:=${LOG_LEVEL_DEBUG}}"

# Log to file (uncomment and set to enable)
# : "${LOG_FILE:=/var/log/myscript.log}"

# Internal function to get timestamp
_get_timestamp() {
  # The millisecond field `%3N` is a GNU coreutils extension. Note macOS/BSD `date`
  # supports plain `%N` but NOT the `%3N` width form — it leaks a literal "3N" into
  # the line — so we must probe the exact `%3N` form, not `%N`. Probe once (cached in
  # _LOGSHELL_HAS_NANOS for the rest of the shell): GNU yields three digits, anything
  # else means fall back to whole-second precision.
  if [[ -z ${_LOGSHELL_HAS_NANOS:-} ]]; then
    case "$(date +%3N 2>/dev/null)" in
    [0-9][0-9][0-9]) _LOGSHELL_HAS_NANOS=yes ;;
    *) _LOGSHELL_HAS_NANOS=no ;;
    esac
  fi
  if [[ ${_LOGSHELL_HAS_NANOS} == yes ]]; then
    date +"%F %T,%3N"
  else
    date +"%F %T"
  fi
}

# Internal logging function
_log() {
  local color="$2"
  local level_str="$3"
  shift 3

  local timestamp
  timestamp=$(_get_timestamp)
  local log_msg="${timestamp}[${level_str}] ${*}"

  # Print to console
  printf "%b%s%b\n\n" "${color}" "${log_msg}" "${COLOR_RESET}"

  # Log to file if enabled
  if [[ -n "${LOG_FILE}" ]]; then
    printf "%s\n" "${log_msg}" >>"${LOG_FILE}"
  fi
}

# Public logging functions
log-debug() {
  ((LOG_LEVEL <= LOG_LEVEL_DEBUG)) && _log "$LOG_LEVEL_DEBUG" "$COLOR_BLUE" "dbg" "$@"
}

log-info() {
  ((LOG_LEVEL <= LOG_LEVEL_INFO)) && _log "$LOG_LEVEL_INFO" "$COLOR_WHITE" "info" "$@"
}

log-warning() {
  ((LOG_LEVEL <= LOG_LEVEL_WARNING)) && _log "$LOG_LEVEL_WARNING" "$COLOR_YELLOW" "warn" "$@"
}

log-error() {
  # Errors go to stderr (>&2) so they don't pollute a function's stdout when its
  # output is captured/piped. The LOG_FILE append inside _log keeps its own redirect,
  # so file logging is unaffected.
  ((LOG_LEVEL <= LOG_LEVEL_ERROR)) && _log "$LOG_LEVEL_ERROR" "$COLOR_RED" "err" "$@" >&2
}

log-run() {
  ((LOG_LEVEL <= LOG_LEVEL_RUN)) && _log "$LOG_LEVEL_RUN" "$COLOR_PURPLE" "run" "$@"
}

log-step() {
  ((LOG_LEVEL <= LOG_LEVEL_STEP)) && _log "$LOG_LEVEL_STEP" "$COLOR_GREEN_U" "step" "$@"
}

# Export functions if needed
export -f log-debug log-info log-warning log-error log-run log-step

# Example usage:
# LOG_LEVEL=$LOG_LEVEL_INFO  # Set log level
# source logshell
# log-debug "This is a debug message"
# log-info "This is an info message"
# log-warning "This is a warning"
# log-error "This is an error"
# log-run "Running command"
# log-step "Starting process"
