#!/bin/bash

#########################
#    GIT
#########################

function git-config-name-mail() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <Your_Name> <your.email@example.com>"
    return 0
  }
  Name=${1}
  Mail=${2}
  git config user.name "${Name}"
  git config user.email "${Mail}"
}

function git-config-global-name-mail() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <Your_Name> <your.email@example.com>"
    return 0
  }
  Name=${1}
  Mail=${2}
  git config --global user.name "${Name}"
  git config --global user.email "${Mail}"
}

function git-commit() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <commit_message> <commitFileDir>"
    return 0
  }
  commitMessage=${1}
  commitFileDir=${2}
  git add "${commitFileDir}"
  git commit -m "${commitMessage}"
}

function git-commit-except() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <commit_message> <commitFileDir> <except_file/folder>"
    return 0
  }
  commitMessage=${1}
  commitFileDir=${2}
  except=${3}
  git add "${commitFileDir}"
  git commit -m "${commitMessage}"
  git reset -- "${except}"
}

function git-push-create-merge() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <mergeMessage> [nameOfMergeBranch]"
    return 0
  }
  mergeMessage=${1}
  nameOfMergeBranch=${2}
  ${nameOfMergeBranch:=mannk_temp_branch}
  git checkout -b "${nameOfMergeBranch}"
  git add .
  git commit -m "${mergeMessage}"

  git push origin "${nameOfMergeBranch}"
}

function git-rename-newbranch-on-remote() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <current_branch_name> <new_branch_name>"
    return 0
  }
  old_branch_name=$1
  new_branch_name=$2

  git branch -m "${old_branch_name}" "${new_branch_name}"
  git push origin "${new_branch_name}"
  git push origin --delete "${old_branch_name}"
  git push --set-upstream origin "${new_branch_name}"
}

function git-delete-branch-on-remote() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <branch_name>"
    return 0
  }
  branch_name=$1

  git push origin --delete "${branch_name}"
  #git branch -d "${branch_name}"
}

function git-rebase-lastN-commit() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <branch_name> <last-n-commit>"
    return 0
  }

  lastncommit=$2
  branch_name=$1

  git checkout "${branch_name}"
  git rebase -i HEAD~"${lastncommit}"
  echo "INFO: run git push --force-with-lease --> apply change to remote"
  #git push --force-with-lease
}

function git-change-author-last-commit() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage: sudo $FUNCNAME <Your_Name> <your.email@example.com>"
    return 0
  }
  Name=${1}
  Mail=${2}
  git config user.name "${Name}"
  git config user.email "${Mail}"
  commit --amend --reset-author
}

function git-setup-mannk98-repo() {
  local ssh_config_file="$HOME/.ssh/config"
  local ssh_host="mannk98"
  local identity_file="$HOME/.ssh/id_github_mannk98"
  local github_hostname="github.com"
  local repo_owner="mannk98"

  # SSH configuration template
  local ssh_config="
Host $ssh_host
  HostName $github_hostname
  User git
  IdentityFile $identity_file
  IdentitiesOnly yes
  Compression yes
  LogLevel INFO
  ForwardAgent yes
  TCPKeepAlive yes
  ServerAliveInterval 60
  ServerAliveCountMax 100
"

  # Ensure ~/.ssh directory exists
  if [[ ! -d "$HOME/.ssh" ]]; then
    mkdir -p "$HOME/.ssh" || {
      echo "Error: Failed to create ~/.ssh directory."
      return 1
    }
    chmod 700 "$HOME/.ssh"


  # Check if SSH config file exists, create if it doesn't
  if [[ ! -f "$ssh_config_file" ]]; then
    touch "$ssh_config_file" || {
      echo "Error: Failed to create $ssh_config_file."
      return 1
    }
    chmod 600 "$ssh_config_file"


  # Check if the specific Host entry already exists
  if grep -q "^Host $ssh_host$" "$ssh_config_file"; then
    echo "Info: SSH configuration for $ssh_host already exists in $ssh_config_file."
  else
    # Append SSH configuration
    if ! echo "$ssh_config" >> "$ssh_config_file"; then
      echo "Error: Failed to append SSH configuration to $ssh_config_file."
      return 1
    echo "Info: Added SSH configuration for $ssh_host to $ssh_config_file."
  fi

  # Configure Git to use SSH instead of HTTPS
  if ! git config --global url."git@$ssh_host:$repo_owner".insteadOf "https://$github_hostname/$repo_owner"; then
    echo "Error: Failed to configure Git URL substitution."
    return 1
  echo "Info: Configured Git to use SSH for https://$github_hostname/$repo_owner."

  # Configure Go private repository
  if command -v go >/dev/null 2>&1; then
    if ! go env -w GOPRIVATE="$github_hostname/$repo_owner"; then
      echo "Error: Failed to set GOPRIVATE environment variable."
      return 1
    echo "Info: Set GOPRIVATE to $github_hostname/$repo_owner."
  else
    echo "Warning: Go is not installed. Skipping GOPRIVATE configuration."
  fi

  return 0
}