}

# not commit what you mount
function docker-commit() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <uuid_image/image_name:tag> <new_image_name:tag> [change_entry_point]"
    return 0
  }
  [[ -n ${3} ]] && {
    change="--change='ENTRYPOINT ${3}'"
  }
  docker commit "${1}" "${2}" "${change}"
}

