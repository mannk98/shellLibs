function docker-network-create-macvlan() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Use: ${FUNCNAME[0]} <parent> <network-name> <host_sub-net> <host_gate-way> <dockerdhcp_ip_range> <hostIP> <macvlan_mode>
        Example: docker-network-create-macvlan enp1s0 macvlan.enp1s0 10.6.200.0/22 10.6.200.1 10.6.203.236/30 passthru"
    return 1
  }

  local parent=$1
  local network=$2
  local subnet=$3

  local host_gateway=$4
  local dockerdhcp_ip_range=$5
  local macvlan_mode=$6

  [[ -z ${dockerdhcp_ip_range} ]] && {
    dockerdhcp_ip_range=""
  } || {
    dockerdhcp_ip_range="--ip-range ${dockerdhcp_ip_range}"
  }

  [[ -z ${macvlan_mode} ]] && {
    macvlan_mode=""
  } || {
    macvlan_mode="-o macvlan_mode=${macvlan_mode}"
  }

  #	[[ -z ${start_ip_of_ip_range} ]] && {
  #		start_ip_of_ip_range=""
  #	} || {
  #		start_ip_of_ip_range="--ip-range ${start_ip_of_ip_range}"
  #	}
  dockerruncmd=$(
    cat <<__
        docker network create -d macvlan -o parent=${parent} --subnet=${subnet} --gateway ${host_gateway} ${dockerdhcp_ip_range} ${macvlan_mode} ${network}
__
  )

  echo "${dockerruncmd}"
  eval "${dockerruncmd}" && return 0 || return 1
}

function docker-commit-and-save() {
  [[ ! $1 || $1 == "-h" ]] && {
    echo "Usage: ${FUNCNAME[0]} <container-name/id> [tag] [/path/to/save]"
    return 0
  }
  containername=$1
  tag=$2
  savedpath=$3

  [[ -z ${savedpath} ]] && {
    savedpath="./"
  }

  [[ -z ${tag} ]] && {
    tag="cloudstackcommit"
  }

  echo "Info: Commit container to image  ${containername}:${tag}"
  docker commit "${containername}" "${containername}:${tag}"
  echo "Info: Save image to ""${savedpath}""/""${containername}"".tar "
  docker save -o "${savedpath}"/"${containername}".tar "${containername}:${tag}"
  docker image rm "${containername}":"${tag}"
}

