#!/bin/bash

function psql-connect() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <host> <port> <user> <password>"
    return 0
  }
  user=$1
  host=$2
  port=$3
  password=$4
  command="psql -U ${user} -h ${host} -p ${port} -W ${password}"
  echo "$command"
  eval "$command"
}

