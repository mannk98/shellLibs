  command=$(
    cat <<EOF
    mysql -u "${MANNK_MYSQL_USER}" -h "${MANNK_MYSQL_HOST}" -p"${MANNK_MYSQL_PASS}" --execute="GRANT ALL PRIVILEGES ON ${db}.* TO '${user}'@'${host}'; FLUSH PRIVILEGES;"   
