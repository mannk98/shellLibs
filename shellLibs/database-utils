#!/bin/bash

function mysql-setEnv() {
  [[ $1 == "-h" ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <user> [host] [password]"
    return 0
  }

  MANNK_MYSQL_USER=$1
  MANNK_MYSQL_HOST=$2
  MANNK_MYSQL_PASS=$3

  export MANNK_MYSQL_USER="${MANNK_MYSQL_USER:-"missing MANNK_MYSQL_USER"}"
  export MANNK_MYSQL_HOST="${MANNK_MYSQL_HOST:-localhost}"
  export MANNK_MYSQL_PASS="${MANNK_MYSQL_PASS:-""}"
}

function mysql-connect() {
  [[ $1 == "-h" ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <user> [host] [password]"
    return 0
  }
  MANNK_MYSQL_USER="${MANNK_MYSQL_USER:-"missing MANNK_MYSQL_USER"}"
  MANNK_MYSQL_HOST="${MANNK_MYSQL_HOST:-localhost}"
  MANNK_MYSQL_PASS="${MANNK_MYSQL_PASS:-""}"

  command=$(
    cat <<EOF
    mysql -u "${MANNK_MYSQL_USER}" -h "${MANNK_MYSQL_HOST}" -p"${MANNK_MYSQL_PASS}"
EOF
  )
  echo "$command"
  eval "$command"

}

function mysql-createUser() {
  [[ $1 == "-h" || -z $1 ]] && {
    echo "Usage (run as root or sudo -s): $FUNCNAME <newuser> <newpass> <accesss_from> <use_native_pass>"
    return 0
  }
  MANNK_MYSQL_USER="${MANNK_MYSQL_USER:-"missing MANNK_MYSQL_USER"}"
  MANNK_MYSQL_HOST="${MANNK_MYSQL_HOST:-localhost}"
  MANNK_MYSQL_PASS="${MANNK_MYSQL_PASS:-""}"

  access_from=$3
  newpass=$2
  user=$1
  use_native_pass=$4
  access_from="${access_from:-"%"}"
  newpass="${newpass:-"password"}"

  [[ $use_native_pass = "no" ]] && {
    use_native_pass="WITH caching_sha2_password"
  }
  [[ $use_native_pass = "yes" ]] && {
    use_native_pass="WITH use_native_pass"
  }
  # default
  use_native_pass="${use_native_pass:-"WITH caching_sha2_password"}"

  command=$(
    cat <<EOF
mysql -u "${MANNK_MYSQL_USER}" -h "${MANNK_MYSQL_HOST}" -p"${MANNK_MYSQL_PASS}" --execute="CREATE USER '${user}'@'${access_from}' IDENTIFIED ${use_native_pass} BY '${newpass}';"   
EOF
  )
  echo "$command"
  eval "$command"
  [[ $? == 0 ]] && {
    echo "Successful created ${user} with password ${newpass} access from ${access_from}"
  }
}

function mysql-grantAllPrivilegesOnDB() {
